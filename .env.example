# Copy to .env and fill in. Never commit .env.
# Provider-agnostic LLM settings: change provider, model and key here only (no code edits).
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
# Optional: any OpenAI-compatible endpoint (xAI, OpenAI, Azure OpenAI, OpenRouter, Ollama ...)
LLM_BASE_URL=

# Fallback key variable names, used only when LLM_API_KEY is empty (see README):
GROQ_API_KEY=
# GROK_API_DEV_KEY=   (alternate fallback name some local setups use)
GROQ_MODEL=

# Data anchoring (defaults: latest data date; yesterday = latest settlement date)
AS_OF_DATE=
YESTERDAY_DATE=
MSIM_USE_SUPPLEMENT=1

# Runtime
REQUEST_DEADLINE_S=90
PORT=8000
